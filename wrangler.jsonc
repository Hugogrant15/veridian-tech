// Cloudflare Workers: serves the prerendered pages from ./dist (about.html is
// served at /about; unknown paths get 404.html with a real 404 status) and runs
// the Worker only for /api/*. Deploys come from Workers Builds on push to `main`.
// Secrets (set in the dashboard as type "Secret", never here): MAILJET_API_KEY,
// MAILJET_SECRET_KEY, and MAIL_LIVE="true" to switch off sandbox mode.
// The two addresses below are public, so they live here and every deploy carries them.
{
  "name": "veridian-tech",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Cloudflare creates the DNS records for these. The bare domain is canonical:
  // a dashboard Redirect Rule ("Redirect from WWW to root") sends www to it.
  "routes": [
    { "pattern": "veridiantechinnovationsltd.com", "custom_domain": true },
    { "pattern": "www.veridiantechinnovationsltd.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "5101",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // One acknowledgement email per visitor address per minute (worker/contact.js).
      "name": "RECEIPT_LIMITER",
      "namespace_id": "5102",
      "simple": { "limit": 1, "period": 60 }
    }
  ],
  "vars": {
    "MAIL_FROM": "noreply@veridiantechinnovationsltd.com",
    // Cloudflare Email Routing forwards info@ to the company Gmail.
    "CONTACT_TO": "info@veridiantechinnovationsltd.com"
  },
  "observability": { "enabled": true }
}
