// Cloudflare Workers: serves the built site from ./dist and runs the Worker
// only for /api/*. Deploys come from Workers Builds on push to `main`.
// Secrets (set in the dashboard, never here): BREVO_API_KEY, MAIL_FROM,
// CONTACT_TO. BREVO_LIVE="true" switches off sandbox mode.
{
  "name": "veridian-tech",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "5101",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
